# THE SIN. Identical to ./Dockerfile except that source is copied BEFORE the
# dependencies are installed. That one reordering is what this step measures.
#
# `COPY . .` depends on every file in the build context, so every file in the
# build context is now an input to the pip install below it.
FROM python:3.12-slim

RUN useradd --create-home --uid 10001 app \
 && mkdir -p /data && chown app:app /data

WORKDIR /app

COPY . .
RUN pip install --no-cache-dir -r requirements.txt

ENV PORT=8080 \
    PYTHONUNBUFFERED=1
USER app
EXPOSE 8080
CMD ["python", "app.py"]
